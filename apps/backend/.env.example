# Backend
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL (local host)
DATABASE_URL=postgresql://organizador:organizador@localhost:5432/organizador?schema=public
# PostgreSQL (inside docker-compose api service)
# DATABASE_URL=postgresql://organizador:organizador@db:5432/organizador?schema=public

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Firebase Cloud Messaging (optional in local)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Image storage
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
